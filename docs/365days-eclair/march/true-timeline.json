  },
  {
    "page": 14,
    "speaker": "抹茶エクレア",
    "text": "「……四月な」",
    "until_seconds": 42.964
  },
  {
    "page": 15,
    "speaker": "主人公",
    "text": "「うん」",
    "until_seconds": 45.338
  },
  {
    "page": 16,
    "speaker": "抹茶エクレア",
    "text": "「ここ来た時は、世界一なって、帰るんやと思うてた」",
    "until_seconds": 49.26
  },
  {
    "page": 17,
    "speaker": "主人公",
    "text": "「……うん」",
    "until_seconds": 51.781
  },
  {
    "page": 18,
    "speaker": "抹茶エクレア",
    "text": "「せやけど」",
    "until_seconds": 54.302
  },
  {
    "page": 19,
    "speaker": "抹茶エクレア",
    "text": "「五月、また来てくれた人がおって」",
    "until_seconds": 57.634
  },
  {
    "page": 20,
    "speaker": "抹茶エクレア",
    "text": "「六月、七月、味が変わってもエクレアで」",
    "until_seconds": 61.188
  },
  {
    "page": 21,
    "speaker": "抹茶エクレア",
    "text": "「八月は大騒ぎで、九月は久世さんに会うて」",
    "until_seconds": 64.815
  },
  {
    "page": 22,
    "speaker": "抹茶エクレア",
    "text": "「十月は、知らん人に伝える練習した」",
    "until_seconds": 68.221
  },
  {
