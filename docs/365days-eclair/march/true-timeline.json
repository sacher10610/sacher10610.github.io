[
  {
    "page": 1,
    "speaker": "主人公",
    "text": "「……抹茶ちゃんが決めればいい」",
    "until_seconds": 3.259
  },
  {
    "page": 2,
    "speaker": "抹茶エクレア",
    "text": "「……え？」",
    "until_seconds": 5.78
  },
  {
    "page": 3,
    "speaker": "主人公",
    "text": "「帰れる。帰らなくてもいい」",
    "until_seconds": 8.891
  },
  {
    "page": 4,
    "speaker": "主人公",
    "text": "「でも、そこから先のことは、抹茶ちゃんの人生だ」",
    "until_seconds": 12.739
  },
  {
    "page": 5,
    "speaker": "抹茶エクレア",
    "text": "「……」",
    "until_seconds": 15.113
  },
  {
    "page": 6,
    "speaker": "主人公",
    "text": "「自分は、この店を一緒に続けたい」",
    "until_seconds": 18.445
  },
  {
    "page": 7,
    "speaker": "主人公",
    "text": "「それは、自分の気持ち」",
    "until_seconds": 21.408
  },
  {
    "page": 8,
    "speaker": "主人公",
    "text": "「でも、それだけで君の答えを決めたくない」",
    "until_seconds": 25.036
  },
  {
    "page": 9,
    "speaker": "抹茶エクレア",
    "text": "「……あんた」",
    "until_seconds": 27.63
  },
  {
    "page": 10,
    "speaker": "主人公",
    "text": "「帰っても、ここに残っても」",
    "until_seconds": 30.741
  },
  {
    "page": 11,
    "speaker": "主人公",
    "text": "「君が選ぶなら、その選択を尊重したい」",
    "until_seconds": 34.221
  },
  {
    "page": 12,
    "speaker": "主人公",
    "text": "「……だから、聞かせて」",
    "until_seconds": 37.185
  },
  {
    "page": 13,
    "speaker": "主人公",
    "text": "「抹茶ちゃんは、どうしたい？」",
